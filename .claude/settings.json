{
  "env": {
    "ECC_HOOK_PROFILE": "minimal"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm --recursive --force *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(gh pr merge*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel alias*)",
      "Bash(vercel domains*)",
      "Bash(vercel env add*)",
      "Bash(vercel env rm*)",
      "Bash(supabase db push)",
      "Bash(supabase db reset)",
      "Bash(supabase db push --linked*)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db push * --linked*)",
      "Bash(supabase db reset * --linked*)",
      "Bash(supabase db push --db-url $*)",
      "Bash(supabase db push --db-url \"$*)",
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_edge_function_secret",
      "mcp__supabase__create_project",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__reset_branch",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(ssh *)",
      "Bash(* > /dev/sd*)",
      "Bash(* > /dev/disk*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.sh",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
