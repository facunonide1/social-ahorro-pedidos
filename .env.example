NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WOOCOMMERCE_URL=https://www.socialahorro.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3001
SYNC_CRON_SECRET=

# URL del repo cuponera. Se usa para los links externos del menú
# (departamentos Comercial y Clientes). Si no se setea, usa el placeholder.
NEXT_PUBLIC_CUPONERA_URL=https://cuponera.socialahorro.com

# Google Drive — ingesta de listas, facturas y maestros. Sin valores.
# Redirect de producción: https://social-ahorro-pedidos.vercel.app/api/integraciones/google-drive/callback
# Las previews arman la redirect con el host del request.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 bytes en base64: openssl rand -base64 32
DRIVE_TOKEN_ENC_KEY=
# Solo corre si es exactamente true.
DRIVE_INGESTA_ENABLED=
# Si se omite, sigue a DRIVE_INGESTA_ENABLED. false deja las listas en previa.
DRIVE_PRECIOS_AUTO_APLICAR=
# Porcentaje de filas con match para aplicar una lista. Default 60.
DRIVE_PRECIOS_UMBRAL_MATCH=
# Score 0-1 del nombre contra el catálogo. Default 0.62.
DRIVE_MATCH_SCORE=
